---
layout: layouts/page.njk
title: Eleventy Prototype Starter
description: Build HTML prototypes with Eleventy, Tailwind CSS v4, and reusable Nunjucks sections. Share a standalone HTML file.
permalink: /
---

{% from "macros/section.njk" import renderSection with context %}
{% from "macros/button.njk" import button %}

{% if site.templateUrl %}
  {%
    set intro = {
      title: sections.hero.title,
      subtitle: sections.hero.subtitle,
      actions: [
        { label: "Use this template", variant: "primary", href: site.templateUrl },
        { label: "Browse sections", variant: "link", href: "/sections/" }
      ]
    }
  %}
{% endif %}
{{ renderSection("hero", "", intro) }}

<section class="starter-showcase" aria-labelledby="fieldnotes-heading">
  <div class="container container--starter split-hero-inner">
    <div class="split-hero-copy">
      <h2 id="fieldnotes-heading">Fieldnotes</h2>
      <p>
        A small walking guide made with the same sections you can use in your own project. Try Paper
        and Ink to see how changing the tokens changes the page.
      </p>
      <div class="starter-links">
        <a class="btn btn--primary" href="{{ '/examples/fieldnotes/' | site_path }}">
          Open Fieldnotes
        </a>
        <a
          class="btn btn--link"
          href="{{ '/assets/downloads/fieldnotes' | site_path }}"
          download="fieldnotes.html"
        >
          Download HTML
        </a>
      </div>
    </div>
    <div class="split-hero-visual">{% include "examples/fieldnotes-map.njk" %}</div>
  </div>
</section>

<section class="starter-next" aria-labelledby="starter-next-heading">
  <div class="container container--starter">
    <div>
      <h2 id="starter-next-heading">{{ sections.cta.title }}</h2>
      <p>{{ sections.cta.description }}</p>
    </div>
    <div class="starter-links">
      {{ button(sections.cta.buttonText, { variant: "link", href: sections.cta.buttonHref }) }}
    </div>
  </div>
</section>
