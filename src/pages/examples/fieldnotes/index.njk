---
layout: layouts/base.njk
title: Fieldnotes
description: A one-page walking guide built from reusable Aceit Kit sections, with two live token treatments.
portableExample: true
hero:
  title: Take the long way.
  subtitle: Three ways to explore your neighbourhood on foot. Start at a park, a row of shops, or the nearest river path.
  actions:
    - label: Pick a walk
      href: '#routes'
      size: lg
routes:
  id: routes
  title: Choose a walk
  description: Pick a starting point near you, then follow the notes for that walk.
  visual: examples/fieldnotes-map.njk
  items:
    - title: The quiet loop
      description: Start at a park entrance and follow the perimeter. Pause where traffic gives way to birds or footsteps. Take one note before you turn for home.
      detail: 20–30 min
    - title: The shopfront walk
      description: Walk a stretch of shops between two cross streets. Look above the windows for old signs, carved dates, or traces of what the buildings used to be.
      detail: 30–45 min
    - title: The waterside detour
      description: Follow the bank to the first bend. Stop where you can see both directions, then turn back or cross at a marked bridge.
      detail: 45–60 min
cta:
  title: Before you go
  description: Bring water and something to write on. Pick a turnaround point before setting off, especially if you’re walking after work.
  buttonText: Back to the walks
  buttonHref: '#routes'
  buttonVariant: link
---

{% from "macros/section.njk" import renderSection with context %}
{% from "macros/button.njk" import button %}

<main id="main-content" tabindex="-1">
  <div class="fieldnotes">
    <header class="container fieldnotes-header">
      <div class="fieldnotes-masthead">
        <a class="fieldnotes-brand" href="#intro">Fieldnotes</a>
        {% if site.githubUrl %}
          {{ button("View repository on GitHub", { href: site.githubUrl, variant: "ghost", icon: "github", iconOnly: true, attrs: { title: "View repository on GitHub" } }) }}
        {% endif %}
      </div>
      <fieldset class="fieldnotes-styles">
        <legend class="sr-only">Appearance</legend>
        <label>
          <input type="radio" name="fieldnotes-style" id="style-paper" checked />
          Paper
        </label>
        <label>
          <input type="radio" name="fieldnotes-style" id="style-ink" />
          Ink
        </label>
      </fieldset>
    </header>
    {{ renderSection("hero", "02", hero) }}
    {{ renderSection("features", "01", routes) }}
    <div id="pack">{{ renderSection("cta", "", cta) }}</div>
    <footer class="container fieldnotes-footer">
      <p>Fieldnotes is an Aceit Kit example.</p>
      <a href="#intro">Back to the introduction</a>
    </footer>
  </div>
</main>
