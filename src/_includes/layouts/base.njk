<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" id="meta-theme-color" content="oklch(0.985 0 0)" />
    <meta name="view-transition" content="same-origin" />

    {# -- Content Security Policy (build only) ------------------------------
       Emitted only when `eleventy.env.runMode == "build"` so the dev server's
       live-reload websocket and inline-injected scripts aren't blocked.
       'unsafe-inline' is required by the theme-flash <script> below and by
       the inline `style="…"` attributes throughout the starter. Replace with
       a nonce-based policy if you need a stricter posture. frame-ancestors
       is intentionally absent — deliver that via an HTTP response header
       (CDN, nginx, Netlify _headers, etc.). #}
    {% if eleventy.env.runMode == "build" %}
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
      />
    {% endif %}

    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="site-build-id" content="{{ build.id }}" />
    <meta name="site-build-sha" content="{{ build.sha }}" />
    {% if site.indexable %}
      {%- set canonicalUrl = page.url | page_canonical_url(site.baseUrl) -%}
      {%- set ogImageUrl = page.url | page_og_image_url(site.baseUrl, ogImage) -%}
      <link rel="canonical" href="{{ canonicalUrl }}" />
      <meta property="og:type" content="{{ ogType or 'website' }}" />
      <meta property="og:site_name" content="{{ site.name }}" />
      <meta property="og:title" content="{{ ogTitle or title or site.name }}" />
      <meta property="og:description" content="{{ ogDescription or description or site.description }}" />
      <meta property="og:url" content="{{ canonicalUrl }}" />
      <meta property="og:image" content="{{ ogImageUrl }}" />
      <meta property="og:image:alt" content="{{ ogImageAlt or title or site.name }}" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="{{ ogTitle or title or site.name }}" />
      <meta name="twitter:description" content="{{ ogDescription or description or site.description }}" />
      <meta name="twitter:image" content="{{ ogImageUrl }}" />
      <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        'name': site.name,
        'description': site.description,
        'url': site.baseUrl
      } | jsonScript | safe }}</script>
    {% endif %}

    <link rel="icon" href="{% faviconDataUrl %}" type="image/svg+xml" />

    {% if not portableExample %}
    {# -- Prevent flash: apply dark class before paint ----------------------- #}
    <script>
      (function () {
        var p = localStorage.getItem('theme-preference') || 'system';
        var dark =
          p === 'dark' ||
          (p === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
        var m = document.querySelector('#meta-theme-color');
        if (m) m.content = dark ? 'oklch(0.15 0 0)' : 'oklch(0.985 0 0)';
      })();
    </script>

    {# -- Fonts: preconnect + Google Fonts (Neometric stack) ----------------- #}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hubot+Sans:wght@200..900&family=Inter+Tight:wght@400;500;600;700;800;900&family=Instrument+Serif&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {% endif %}

    {# -- Tailwind v4 Browser Build ------------------------------------------ #}
    {#
      Prototype-only CDN waiver: @tailwindcss/browser@4 is intentionally used
      by this starter for zero-build prototyping. It is major-version pinned,
      but not byte-stable enough for SRI. For production, replace this with a
      first-party Tailwind CLI build and remove cdn.jsdelivr.net from CSP.

      IMPORTANT: @theme values are evaluated by the TW4 JIT at parse time,
      before tokens.css (loaded via <link> below) is available. That means
      var(--token) refs here CANNOT resolve and will break utility generation
      for any non-color namespace. Rule of thumb:

        - Fonts, type scale, spacing base, radii, shadows → literal values
        - Color tokens → var(--token) is fine (Tailwind emits
          `.bg-primary { background: var(--primary) }`, which resolves at
          render time, not JIT time)

      Keep light-mode values here; dark-mode overrides live in tokens.css via
      the `html.dark` cascade and apply at runtime.
    #}
    {% if site.compiledTailwind and not portableExample %}
      <link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | site_path }}?v={{ build.id }}" />
    {% else %}
      {% if not portableExample %}<script
        crossorigin="anonymous"
        src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"
      ></script>{% endif %}
      <style{% if not portableExample %} type="text/tailwindcss"{% endif %}>
      @layer base, components, utilities;

      {% if portableExample %}:root{% else %}@theme{% endif %} {
        {# Values come from src/_data/theme.json. This keeps the layout as an
           adapter and leaves the token manifest as the authoritative module.
           The `safe` filter is intentional: theme.json is trusted project
           data containing CSS literals, not user/CMS input. #}
        {% for section in theme.sections %}
          /* -- {{ section.label }} -- */
          {% for token in section.tokens %}
            {{ token.name }}: {{ token.value | safe }};
          {% endfor %}
        {% endfor %}
      }
      </style>
    {% endif %}

    {# -- CSS files ---------------------------------------------------------- #}
    <link rel="stylesheet" href="{{ '/assets/css/tokens.css' | site_path }}?v={{ build.id }}" />
    <link rel="stylesheet" href="{{ '/assets/css/base.css' | site_path }}?v={{ build.id }}" />
    <link rel="stylesheet" href="{{ '/assets/css/components.css' | site_path }}?v={{ build.id }}" />
    <link rel="stylesheet" href="{{ '/assets/css/utilities.css' | site_path }}?v={{ build.id }}" />

  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    {{ content | safe }}

    {% if not portableExample %}
    {# -- JS modules (deferred) --------------------------------------------- #}
    <script defer src="{{ '/assets/js/page-lifecycle.js' | site_path }}?v={{ build.id }}"></script>
    <script defer src="{{ '/assets/js/observer.js' | site_path }}?v={{ build.id }}"></script>
    <script defer src="{{ '/assets/js/theme-toggle.js' | site_path }}?v={{ build.id }}"></script>
    <script defer src="{{ '/assets/js/view-transitions.js' | site_path }}?v={{ build.id }}"></script>
    <script defer src="{{ '/assets/js/mobile-menu.js' | site_path }}?v={{ build.id }}"></script>
    {% if site.analyticsEnabled %}
      <script defer src="{{ '/assets/js/analytics.js' | site_path }}?v={{ build.id }}"></script>
    {% endif %}
    {% endif %}
  </body>
</html>
