{# Hero — Default (hero-01) #}
{% from "macros/button.njk" import button %}
{% set heroConfig = sectionConfig or hero or sections.hero %}

<section class="starter-intro">
  <div class="container container--starter">
    <h1>{{ heroConfig.title or heroTitle }}</h1>
    <p>{{ heroConfig.subtitle or heroSubtitle }}</p>
    <div class="starter-links">
      {% for action in heroConfig.actions %}
        {{ button(action.label, action) }}
      {% endfor %}
    </div>
  </div>
</section>
